#!/usr/bin/env bash

set -Eeuo pipefail

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

[[ $# -eq 1 ]] || fail 'Usage: bin/validate-domain <Domain>'
domain="$1"
[[ "$domain" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || fail 'Domain must start with a letter and contain only letters and digits.'

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail 'Not inside a Git repository.'
root="$(git rev-parse --show-toplevel)"
[[ "$(pwd -P)" == "$(cd "$root" && pwd -P)" ]] || fail "Run from repository root: $root"
test_path="tests/Unit/Domain/$domain"
[[ -d "$test_path" ]] || fail "Domain test directory does not exist: $test_path"
[[ -x ./vendor/bin/sail ]] || fail 'Executable ./vendor/bin/sail is missing.'

printf 'Running targeted %s tests...\n' "$domain"
./vendor/bin/sail artisan test "$test_path"
printf 'Running full test suite...\n'
./vendor/bin/sail artisan test
printf 'Checking formatting...\n'
if ! ./vendor/bin/sail pint --test; then
    printf 'ERROR: Pint failed. Run: ./vendor/bin/sail pint\n' >&2
    exit 1
fi
printf 'Checking diff whitespace...\n'
git diff --check
printf 'Domain validation: passed\n'
