#!/usr/bin/env bash

set -Eeuo pipefail

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail 'Not inside a Git repository.'
root="$(git rev-parse --show-toplevel)"
[[ "$(pwd -P)" == "$(cd "$root" && pwd -P)" ]] || fail "Run from repository root: $root"
docker info >/dev/null 2>&1 || fail 'Docker is not reachable. Verify `docker info`.'
[[ -x ./vendor/bin/sail ]] || fail 'Executable ./vendor/bin/sail is missing.'
./vendor/bin/sail ps >/dev/null 2>&1 || fail 'Sail services are not reachable. Run `./vendor/bin/sail up -d`.'

branch="$(git branch --show-current)"
[[ -n "$branch" ]] || fail 'Git is in detached HEAD state.'
printf 'Repository: %s\nBranch: %s\n' "$root" "$branch"

status="$(git status --short)"
if [[ -n "$status" ]]; then
    printf 'WARNING: Working tree contains changes:\n%s\n' "$status" >&2
else
    printf 'Git status: clean\n'
fi
printf 'Environment: ready\n'
